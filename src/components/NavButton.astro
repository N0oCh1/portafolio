---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<"button"> {
    isSelected?: boolean;
    id: string;
    class: string;
}

const { isSelected, id, class: className, ...ref } = Astro.props as Props;
---

<button 
    id={id}
    {...ref}
    class={`${className} text-white rounded-2xl px-3 py-1 drop-shadow-2xl transition-colors duration-300 hover:bg-white/10`}
>
    <slot />
</button>

