---
import LayoutCenter from "@/layouts/LayoutCenter.astro";
import WIP from "@components/WIP.astro";
---

<LayoutCenter>
  <div
    class={`
            bg-[#ffffff00] 
            w-3/4 h-150
            rounded-3xl
            items-center
            `}
  >
    <img
      id="home"
      src="/src/assets/lostsignal.gif"
      alt="Lost Signal"
      class="w-full h-full object-cover rounded-3xl"
    />
      <div class="h-150 w-full grid grid-cols-2 grid-rows-2 gap-4 mt-10" id="about">
        <div class="bg-white rounded-2xl shadow-2xl ">

        </div>
        <div class="bg-white row-span-2 rounded-2xl shadow-2xl ">
          <h1>
            Ruben Feng, Software developer
          </h1>
        </div>
        <div class="bg-white rounded-2xl shadow-2xl ">

        </div>
      </div>
      <WIP />
  </div>
</LayoutCenter>
