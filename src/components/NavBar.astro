---
import NavButton from "@components/NavButton.astro";
---

<nav>
    <ul class={
        `
        flex gap-4 flex-row 
        bg-radial-[at_50%_75%] from-[#8d8ddb]/80 via-violet-900 to-[#110834]/80 to-90%
        justify-center py-2 px-5 rounded-2xl 
        fixed transform -translate-x-1/2 left-1/2 top-10
        shadow-2xl shadow-[#8d8ddb]/40
        `
        }>
        <li><NavButton class="NavButton" id="home-btn"><a href="#home">Home</a></NavButton></li>
        <li><NavButton class="NavButton" id="about-btn"><a href="#about">About</a></NavButton></li>
        <li><NavButton class="NavButton" id="projects-btn"><a href="#projects">Projects</a></NavButton></li>
        <li><NavButton class="NavButton" id="contact-btn"><a href="#contact">Contact</a></NavButton></li>
    </ul>
</nav>

<script>
    const buttons = document.querySelectorAll('.NavButton');
    buttons.forEach(button => {
        button.addEventListener('click', () => {
            buttons.forEach(btn => btn.classList.remove('bg-blue-500/40'));
            button.classList.add('bg-blue-500/40');
        });
    });
</script>